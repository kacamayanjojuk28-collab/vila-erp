# Uygulama: süper kullanıcı olmayan rol
DATABASE_URL="postgresql://vila_app:CHANGE_ME@127.0.0.1:55432/vila"
# Yalnızca Prisma migration/backup komutları
MIGRATION_DATABASE_URL="postgresql://vila:CHANGE_ME_ADMIN@127.0.0.1:55432/vila"
APP_ORIGIN="http://localhost:3000"
# SEO environment is explicit: a production build may still be staging.
VILA_SITE_ENV="staging"
# Set only after verifying the live HTTPS domain; do not use APP_ORIGIN here.
VILA_PUBLIC_ORIGIN=""
# PG_BIN="C:/Users/YOU/AppData/Local/Programs/PostgreSQL18/pgsql/bin"

# Optional, only after verifying a proxy that strips client-supplied headers.
# Proxy injects x-vila-proxy-token and a single canonical X-Forwarded-For IP.
# Unset: forwarded IPs are ignored and clients share an unverified budget.
# VILA_TRUSTED_PROXY_SECRET="generate-at-least-32-random-characters"
